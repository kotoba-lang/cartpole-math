(ns kotoba.cartpole-step (:export [next-x next-x-dot next-theta next-theta-dot]))

(defn theta-acc [] :f64
  (let [sin-t (f64-sin-bounded 0.2)
        cos-t (f64-cos-bounded 0.2)
        total 1.1
        temp (f64-div 1.0 total)
        numerator (f64-sub (f64-mul 9.8 sin-t)
                           (f64-mul cos-t temp))
        mass-term (f64-div (f64-mul 0.1 (f64-mul cos-t cos-t)) total)
        denominator (f64-mul 0.5 (f64-sub (f64-div 4.0 3.0) mass-term))]
    (f64-div numerator denominator)))

(defn x-acc [] :f64
  (let [cos-t (f64-cos-bounded 0.2)
        correction (f64-div (f64-mul 0.05 (f64-mul (theta-acc) cos-t)) 1.1)]
    (f64-sub (f64-div 1.0 1.1) correction)))

(defn next-x-dot [] :f64
  (f64-mul 0.02 (x-acc)))

(defn next-x [] :f64
  (f64-mul 0.02 (next-x-dot)))

(defn next-theta-dot [] :f64
  (f64-mul 0.02 (theta-acc)))

(defn next-theta [] :f64
  (f64-add 0.2 (f64-mul 0.02 (next-theta-dot))))
